/android/app/release

# Firebase native config files contain project keys - do NOT commit.
# lib/firebase_options.dart is a committed placeholder driven by --dart-define;
# if you regenerate it with `flutterfire configure`, keep it out of git.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

