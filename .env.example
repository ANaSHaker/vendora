# Copy to `.env` and fill in, then run:
#   flutter run --dart-define-from-file=.env
# `.env` is git-ignored. Never commit real values.

# REST backend (Laravel API) — base URL without trailing slash
API_BASE_URL=http://localhost:8000

# Public URL of the web build (used for shareable menu / booking links)
APP_BASE_URL=http://localhost:5000

# Firebase (Analytics, Cloud Messaging, Firestore, Storage)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MEASUREMENT_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_WINDOWS_APP_ID=

# Web push (Firebase Cloud Messaging VAPID key)
FCM_VAPID_KEY=
